# Copy to .env. Generate fresh values; do not commit .env.
# Use URL-safe characters for POSTGRES_PASSWORD (openssl rand -hex 24).
POSTGRES_PASSWORD=
# openssl rand -base64 32
ENCRYPTION_KEY=
PUBLIC_ORIGIN=http://localhost:3000
# Only permitted for a localhost origin. Use true behind HTTPS.
COOKIE_SECURE=false
APP_ENV=production
# Explicit, exact hostnames for a local receiver; requires APP_ENV=development.
DEV_ENDPOINT_HOSTS=
# Set these for local Go commands, not for Compose (Compose supplies its own DSN).
# DATABASE_URL=postgres://hookgarde:password@127.0.0.1:5432/hookgarde?sslmode=disable
# HTTP_ADDR=127.0.0.1:8080
LIMIT_PROJECTS=5
LIMIT_ENDPOINTS=10
LIMIT_TARGETS=10
LIMIT_MONTHLY_EVENTS=10000
LIMIT_QUEUE_JOBS=100000
LIMIT_ORGANIZATION_JOBS=10000
STORAGE_LIMIT_BYTES=10737418240
# Admission stops below the database-size budget to leave room for outcomes.
STORAGE_RESERVE_BYTES=268435456
RATE_INGEST_PER_MINUTE=60
RATE_MUTATIONS_PER_MINUTE=30
RATE_LOGIN_PER_15_MINUTES=10
